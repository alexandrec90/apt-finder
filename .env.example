# Copy to `.env` and fill in. `.env` is gitignored; this file is the committed
# template, so keep every key here with a safe placeholder value.

# ---------------------------------------------------------------------------
# Worktree identity and host ports
# ---------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME MUST equal this checkout's directory name. It namespaces
# the stack's containers, network, and volumes, so a worktree running in parallel
# stays fully independent — and `scripts/docker_common.py`-style tooling filters
# `docker ps` by it.
COMPOSE_PROJECT_NAME=apt-finder

# Every published port is `conventional_base + slot`, where this checkout's slot
# is 6. The registry that assigns slots is devkit's `ports.toml` — add a
# project there rather than picking a free-looking number by hand. Re-generate
# this block with: python <devkit>/scripts/devkit_ports.py apt-finder
APP_HOST_PORT=8006
DB_HOST_PORT=5438

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The host-side URL. It must agree with DB_HOST_PORT above — that is the pairing
# that breaks first when a worktree's ports are edited by hand.
DATABASE_URL=postgresql+psycopg://apt_finder:apt_finder_local_dev@127.0.0.1:5438/apt_finder
POSTGRES_USER=apt_finder
POSTGRES_PASSWORD=apt_finder_local_dev
POSTGRES_DB=apt_finder

# ---------------------------------------------------------------------------
# Search criteria
# ---------------------------------------------------------------------------
# Monthly rent, CAD. MIN exists to drop $0/$1 placeholder and scam listings, which
# otherwise sort straight to the top of the match list.
MAX_RENT_CAD=2000
MIN_RENT_CAD=400
REQUIRE_WASHER=true
REQUIRE_DRYER=true
REQUIRE_KITCHEN_APPLIANCES=true
EXCLUDE_ROOMS=true

# ---------------------------------------------------------------------------
# Geography — Gatineau, Québec only
# ---------------------------------------------------------------------------
# Ottawa is across the river and both marketplaces treat the two cities as one metro
# area, so province is decided independently of distance (postal code first, then an
# explicit ON/QC token, then a municipality list).
#
# ALLOW_UNKNOWN_PROVINCE=false means a listing whose province cannot be established is
# REJECTED rather than assumed local. That is the safe default here: with Ontario 5 km
# away, "unknown" is far likelier to be Ottawa than a missed Gatineau unit. Set it to
# true to see those as `maybe` instead.
CENTRE_LAT=45.4765
CENTRE_LON=-75.7013
RADIUS_KM=40
ALLOW_UNKNOWN_PROVINCE=false

# ---------------------------------------------------------------------------
# Throttling — tuned to protect the accounts, not to finish quickly
# ---------------------------------------------------------------------------
# A full sweep takes ~20 minutes with these values. That is deliberate: a banned
# Facebook account cannot be undone, and it takes the whole search with it.
# Intervals are jittered (never a fixed rate), a longer pause happens every N requests,
# and the per-run cap bounds the blast radius of a pagination bug.
THROTTLE_MIN_SECONDS=6
THROTTLE_MAX_SECONDS=18
THROTTLE_LONG_PAUSE_EVERY=12
THROTTLE_LONG_PAUSE_MIN_SECONDS=45
THROTTLE_LONG_PAUSE_MAX_SECONDS=120
THROTTLE_MAX_REQUESTS_PER_RUN=120
# Consecutive 429/403/captcha responses that abort the run entirely.
THROTTLE_BLOCK_THRESHOLD=2

# ---------------------------------------------------------------------------
# Kijiji
# ---------------------------------------------------------------------------
# Comma-separated. VERIFY the category/location ids against the live site before the
# first real run — a stale id returns an unrelated result set rather than an error.
KIJIJI_SEARCH_URLS=https://www.kijiji.ca/b-appartement-condo/gatineau/c37l1700242
KIJIJI_MAX_PAGES=3
# Optional: only needed if you hit a login wall. Paste the `Cookie:` header from a
# logged-in browser session.
KIJIJI_COOKIE=

# ---------------------------------------------------------------------------
# Facebook Marketplace
# ---------------------------------------------------------------------------
# There is no password here on purpose. Run `apt-finder facebook-login` once: a headed
# browser opens, you sign in yourself (2FA included), and the cookies persist in the
# profile directory below. Later runs reuse it headlessly.
# Comma-separated, same as KIJIJI_SEARCH_URLS above.
FACEBOOK_SEARCH_URLS=https://www.facebook.com/marketplace/gatineau/propertyrentals?minPrice=400&maxPrice=2000&exact=false
FACEBOOK_PROFILE_DIR=.local/facebook-profile
FACEBOOK_HEADLESS=true
FACEBOOK_MAX_LISTINGS=60

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
# Resource attributes. `service.instance.id` is what distinguishes two worktrees
# exporting to the same collector — without it their metrics silently merge.
OTEL_SERVICE_NAME=apt-finder
OTEL_RESOURCE_ATTRIBUTES=service.name=apt-finder,service.instance.id=apt-finder,deployment.environment=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4324
